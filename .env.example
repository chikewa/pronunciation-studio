# Pronunciation Studio — environment configuration
# Copy to `.env` (backend reads these) or export in your shell. All have
# sensible local-first defaults; nothing here is required for basic use.

# Where user data (recordings, progress, generated references) is stored.
# Default: <project>/data
#PRON_DATA_DIR=/path/to/data

# Upload / analysis limits
PRON_MAX_UPLOAD_BYTES=20971520     # 20 MB
PRON_MIN_DURATION_S=0.3
PRON_MAX_DURATION_S=60.0

# Pronunciation model backend (offline by default)
#   OPENPRONOUNCE_TTS=piper   -> fully offline reference audio (RECOMMENDED)
#   OPENPRONOUNCE_TTS=gtts    -> uses Google network TTS (needs internet)
OPENPRONOUNCE_TTS=piper
OPENPRONOUNCE_TTS_VOICE=en_US-lessac-medium

# CPU or GPU. We only test/support CPU; set to cuda if you have a compatible GPU
# and a CUDA build of torch.
OPENPRONOUNCE_DEVICE=cpu

# HuggingFace cache for the wav2vec2 + piper models.
# Default: ~/.cache/huggingface
#HF_HOME=/path/to/hf-cache

# Comma-separated list of allowed CORS origins for the API.
PRON_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) — set at build time, prefix VITE_ ---
# Origin of the backend when the frontend is served separately (e.g. a static
# host). Leave empty when the dev server proxies /api to the backend.
#VITE_API_BASE=http://localhost:8000
